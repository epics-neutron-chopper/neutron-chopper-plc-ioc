
# One observation when working with PLCs needs to be mentioned here:
# When we are unsure about the "manipulation" of values inside the PLC
# it may be a good idea to have two variables:
# One "setpoint variable" connected to an EPICS output record,
# one "readback variable" connected to an EPICS input record.
# So we end up with 2 records: SetFAmplitude_S (setpoint)
# and SetFAmplitude_RB (readback).
# As a theoretical example:
# The user sets an amplitude of 99.99 (as a result of a calulation)
# That goes into SetFAmplitude_S
# The PLC rounds it into 100.0, because that is what the hardware can
# achieve.
# While ramping up, the amplitude changes between lets say 50.0 to 100.0
# To have that value visible in an experiment log file a 3rd variable
# may be needed: FAmplitude_Act


#record to get current frequency
record(ai,"$(P)GetCurrentFrequency"){
    field(DESC, "Current Frequency")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1)ADSPORT=$(ADSPORT=851)/GVL_EPICS.stDCU[1].Spd_R?")
    field(PREC, "2")
    field(SCAN, "I/O Intr")
    field(EGU, "Hz")
}

# record to set frequency
record(ao,"$(P)SetFrequency"){
    field(DESC, "Set Frequency")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0,1)ADSPORT=$(ADSPORT=851)/GVL_EPICS.stDCU[1].Spd_S=")
    field(PREC, "2")
    field(EGU, "Hz")
}

# record to verify is the set frequency is applied

record(ai,"$(P)SetFrequencyRB"){
    field(DESC, "Set Frequency Readback")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1)ADSPORT=$(ADSPORT=851)/GVL_EPICS.stDCU[1].SpdS_RB?")
    field(PREC, "2")
    field(EGU, "Hz")
    field(SCAN, "I/O Intr")
}

# record to send commands

record(ao,"$(P)SendCommand"){
    field(DESC, "Set Command")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0,1)ADSPORT=$(ADSPORT=851)/GVL_EPICS.stDCU[1].C_ExecuteUser=")
}

#record to send commands using string

record(mbbo, "$(P)SendCommandString"){
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(ZRST, "No request")
    field(ONST, "Start")
    field(TWST, "Stop")
    field(THST, "Clear Alarms")
    field(OUT,"$(P)SendCommand PP")
    field(DESC, "Send commands using string")
}

#record to get Motor Temperature
record(ai,"$(P)GetMotorTemperature"){
    field(DESC, "Current Motor Temperature")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1)ADSPORT=$(ADSPORT=851)/GVL_EPICS.stDCU[1].MtrTemp_R?")
    field(PREC, "2")
    field(SCAN, "I/O Intr")
    field(EGU, "degC")
}

#record to get Drive Temperature
record(ai,"$(P)GetDriveTemperature"){
    field(DESC, "Current Drive Temperature")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1)ADSPORT=$(ADSPORT=851)/GVL_EPICS.stDCU[1].DrvTemp_R?")
    field(PREC, "2")
    field(SCAN, "I/O Intr")
    field(EGU, "degC")
}

record(mbbi, "$(P)CurrentStateInfo") {
    field(DESC, "Current State Information of the chopper")
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT),0,1)ADSPORT=$(ADSPORT=851)/GVL_EPICS.stDCU[1].ChopState_R?")

    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(FRVL, "4")
    field(FVVL, "5")
    field(SXVL, "6")
    field(ZRST, "Comms Not OK")
    field(ONST, "Initialisation")
    field(TWST, "Ready")
    field(THST, "Rotating")
    field(FRST, "Coasting")
    field(FVST, "Stopping")
    field(SXST, "E.stopping")
    field(SCAN, "I/O Intr")
}



# Monitoring how current frequency is different from the set frequency

record(calc, "$(P)DifferenceFromSetFrequency") {
    field(DESC, "Monitoring how current frequency is different from the set frequency")
    field(PREC, "3")
    field(EGU, "Hz")
    field(INPA, "$(P)GetCurrentFrequency CP")
    field(INPB, "$(P)SetFrequencyRB CP")
    field(CALC, "ABS(A-B)")

}

#Setting the Frequency tolerance value
record(ao, "$(P)StableFrequencyTolerance") {
    field(DESC, "Tolerance")
    field(EGU, "Hz")
    field(PREC, "1")
    # Allowable tolerance range:
    # DRVL = minimum tolerance
    # DRVH = maximum tolerance
    # VAL  = initial/default tolerance
    field(DRVL, "0.2")
    field(DRVH, "1")
    field(VAL, "1")
}
record(ao, "$(P)ApproachingFrequencyTolerance") {
    field(DESC, "Approaching Frequency Tolerance")
    field(EGU, "Hz")
    field(PREC, "1")
    # Allowable tolerance range:
    # DRVL = minimum tolerance
    # DRVH = maximum tolerance
    # VAL  = initial/default tolerance
    field(DRVL, "1")
    field(DRVH, "4")
    field(VAL, "1")
}

# Setting stability alarm if the current frequency is far from set frequency



record(mbbi, "$(P)StabilityAlarm") {
    field(DESC, "stability alarm if the current frequency is far from set frequency")
    #field(INP, "$(P)StabilityCondition CP")
    field(ZRVL, "Stable")
    field(ONVL, "Approaching")
    field(TWVL, "Off Target")
}


record(calcout, "$(P)StabilityCondition") {
    field(DESC, "Setting stability alarm if the current frequency is far from set frequency")

    field(INPA, "$(P)DifferenceFromSetFrequency CP")
    field(INPB, "$(P)StableFrequencyTolerance CP")
    field(INPC, "$(P)ApproachingFrequencyTolerance CP")
    
    field(CALC, " A<=B ? 0 : ( B<A & A<C ? 1 : 2 )")
    field(OUT, "$(P)StabilityAlarm PP")
}
##################################

# setting the state of sweep programme (Not requested, Start, Stop)

record (bo, "$(P)EnableSweepProgram") {
    field(DESC, "Enablingthe sweep programme")
    field(ZNAM, "Disable")    # Option 0
    field(ONAM, "Enable")   # Option 1
    #field(TWST, "Stop")  # Option 2
     
}


#============================================================
record(ao, "$(P)AskStartFrequency"){
    field(DESC, "Ask user to give start frequency")
    field(VAL, "0")
    field(EGU, "Hz")
    field(PREC, "2")
    field(FLNK, "$(P)SetStartFrequency")
    field(SDIS,"$(P)EnableSweepProgram" )
    field(DISV, "0")
}

#==================================================

record(ao, "$(P)AskEndFrequency"){
    field(DESC, "Ask for end frequency")
    field(VAL, "0")
    field(EGU, "Hz")
    field(PREC, "2")
    field(SDIS,"$(P)EnableSweepProgram" )
    field(DISV, "0")
}

record(ao, "$(P)AskNumberOfSteps"){
    field(DESC, "Ask for number of steps ")
    field(VAL, "0")
    field(SDIS,"$(P)EnableSweepProgram" )
    field(DISV, "0")
}

record(ao, "$(P)AskScanTimeAtEachStep"){
    field(DESC, "Scan time required at each step")
    field(VAL, "0")
    field(EGU, "Sec")
    field(PREC, "2")
    field(SDIS,"$(P)EnableSweepProgram" )
    field(DISV, "0")
}


record (bo, "$(P)ScanningStatus") {
    field(DESC, "Scanning Status")
    field(ZNAM, "Scanning Done")    # Option 0
    field(ONAM, "Scanning")   # Option 1
    #field(TWST, "Stop")  # Option 2
     
}

#Start running the sweep programme by executing python script

record (bo, "$(P)RunSweepProgram") {
    field(DESC, "Run sweep programme")
    field(ZNAM, "Stop")    # Option 0
    field(ONAM, "Run")   # Option 1
    #field(TWST, "Stop")  # Option 2
}