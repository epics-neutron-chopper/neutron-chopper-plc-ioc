<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <grid_color>
    <color name="Background" red="255" green="255" blue="255">
    </color>
  </grid_color>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <text>Stable Frequency Tolerance</text>
    <x>30</x>
    <y>80</y>
    <width>230</width>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry_1</name>
    <pv_name>Chopper:StableFrequencyTolerance</pv_name>
    <x>250</x>
    <y>80</y>
    <width>120</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_3</name>
    <text>Approaching Tolerance</text>
    <x>30</x>
    <y>130</y>
    <width>150</width>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry_2</name>
    <pv_name>Chopper:ApproachingFrequencyTolerance</pv_name>
    <x>250</x>
    <y>130</y>
    <width>300</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_4</name>
    <text>Difference from Set Frequency</text>
    <x>30</x>
    <y>200</y>
    <width>230</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_2</name>
    <pv_name>Chopper:DifferenceFromSetFrequency</pv_name>
    <x>250</x>
    <y>200</y>
    <width>260</width>
  </widget>
  <widget type="stripchart" version="2.1.0">
    <name>Strip Chart</name>
    <x>170</x>
    <y>260</y>
    <y_axes>
      <y_axis>
        <title>Frequency Offset (Hz)</title>
        <autoscale>false</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>false</show_grid>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <y_pv>Chopper:DifferenceFromSetFrequency</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
</display>
